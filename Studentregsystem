class Student {
    String name;
    int rollNo;
    void display() {
        System.out.println("Student Details");
        System.out.println("Student Name : " + name);
        System.out.println("Roll Number  : " + rollNo);
    }
    public static void main(String[] args) {
        Student s1 = new Student();
        s1.name = "gangula bhanu tej";
        s1.rollNo = 036;
        s1.display();
    }
}
