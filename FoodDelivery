class Task implements Runnable {
    private String activity;
    Task(String activity) { this.activity = activity; }

    public void run() {
        Thread t = Thread.currentThread();
        for (int i = 1; i <= 3; i++) {
            System.out.println("Thread: " + t.getName() + " | Priority: " + t.getPriority()
                    + " | Activity: " + activity + " (step " + i + ")");
            try { Thread.sleep(300); } catch (InterruptedException e) { }
        }
    }
}

public class FoodDelivery {
    public static void main(String[] args) {
        Thread order = new Thread(new Task("Processing customer order"), "OrderProcessing");
        Thread track = new Thread(new Task("Tracking delivery location"), "DeliveryTracking");
        Thread notify = new Thread(new Task("Sending order-status notification"), "Notification");

        order.setPriority(10);   // most important
        track.setPriority(7);
        notify.setPriority(4);

        order.start();
        track.start();
        notify.start();
    }
}
