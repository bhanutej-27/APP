package payments;

import transaction.OnlineTransaction;

public class UPIPayment implements SecurePayment, OnlineTransaction {

    @Override
    public void pay(double amount) {
        System.out.println("UPI Payment");
        System.out.println("Amount Paid : Rs." + amount);
    }

    @Override
    public void verifyPayment() {
        System.out.println("UPI payment verified successfully.");
    }
}

package payments;

import transaction.OnlineTransaction;

public class CardPayment implements Payment, OnlineTransaction {

    @Override
    public void pay(double amount) {
        System.out.println("Card Payment");
        System.out.println("Amount Paid : Rs." + amount);
    }
}

import accounts.Account;
import accounts.SavingsAccount;
import accounts.CurrentAccount;

import payments.Payment;
import payments.UPIPayment;
import payments.CardPayment;

import transaction.OnlineTransaction;

public class Main {

    public static void main(String[] args) {

        // ---------------------------------
        // 1. Runtime Polymorphism
        // ---------------------------------

        System.out.println("===== ACCOUNT DETAILS =====");

        Account account;

        account = new SavingsAccount(
            1001,
            "Bhanu",
            50000,
            5.5
        );

        account.displayDetails();

        System.out.println();

        account = new CurrentAccount(
            1002,
            "Rahul",
            75000,
            25000
        );

        account.displayDetails();


        // ---------------------------------
        // 2. Payment Interface
        // ---------------------------------

        System.out.println("\n===== PAYMENT DETAILS =====");

        Payment payment;

        payment = new UPIPayment();
        payment.pay(2500);

        System.out.println();

        payment = new CardPayment();
        payment.pay(5000);


        // ---------------------------------
        // 3. Secure Payment
        // ---------------------------------

        System.out.println("\n===== SECURE PAYMENT =====");

        UPIPayment upi = new UPIPayment();

        upi.pay(3000);
        upi.verifyPayment();


        // ---------------------------------
        // 4. Tagging Interface
        // ---------------------------------

        System.out.println("\n===== ONLINE TRANSACTION CHECK =====");

        if (upi instanceof OnlineTransaction) {
            System.out.println("UPI is an online transaction.");
        }

        CardPayment card = new CardPayment();

        if (card instanceof OnlineTransaction) {
            System.out.println("Card payment is an online transaction.");
        }
    }
}




