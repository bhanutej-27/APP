import javax.swing.*;
import java.awt.*;

public class StudentRegistration extends JFrame {
    JTextField nameField, regField;
    JRadioButton male, female;
    JComboBox<String> deptBox;
    JButton submit;

    StudentRegistration() {
        setTitle("Student Registration");
        setSize(400, 300);
        setLayout(new GridLayout(5, 2, 10, 10));
        setDefaultCloseOperation(EXIT_ON_CLOSE);

        nameField = new JTextField();
        regField = new JTextField();
        male = new JRadioButton("Male");
        female = new JRadioButton("Female");
        ButtonGroup bg = new ButtonGroup();
        bg.add(male);
        bg.add(female);
        JPanel genderPanel = new JPanel();
        genderPanel.add(male);
        genderPanel.add(female);
        deptBox = new JComboBox<>(new String[]{"CSE", "ECE", "EEE", "MECH", "CIVIL", "IT"});
        submit = new JButton("Submit");

        add(new JLabel("  Student Name:"));   add(nameField);
        add(new JLabel("  Register Number:")); add(regField);
        add(new JLabel("  Gender:"));          add(genderPanel);
        add(new JLabel("  Department:"));      add(deptBox);
        add(new JLabel());                     add(submit);

        submit.addActionListener(e -> {
            String gender = male.isSelected() ? "Male" : female.isSelected() ? "Female" : "";
            if (nameField.getText().trim().isEmpty() || regField.getText().trim().isEmpty() || gender.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Please fill all the details!", "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }
            String info = "Name: " + nameField.getText()
                    + "\nRegister No: " + regField.getText()
                    + "\nGender: " + gender
                    + "\nDepartment: " + deptBox.getSelectedItem();
            JOptionPane.showMessageDialog(this, info, "Registration Details", JOptionPane.INFORMATION_MESSAGE);
        });

        setLocationRelativeTo(null);
        setVisible(true);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(StudentRegistration::new);
    }
}
