import java.util.*;

class Candidate {
    int id;
    String name;
    int aptitude, technical, communication;

    Candidate(int id, String name, int aptitude,
              int technical, int communication) {
        this.id = id;
        this.name = name;
        this.aptitude = aptitude;
        this.technical = technical;
        this.communication = communication;
    }

    int getTotalScore() {
        return aptitude + technical + communication;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        Candidate[] c = new Candidate[n];

        for (int i = 0; i < n; i++) {
            int id = sc.nextInt();
            String name = sc.next();
            int aptitude = sc.nextInt();
            int technical = sc.nextInt();
            int communication = sc.nextInt();

            c[i] = new Candidate(id, name, aptitude,
                                 technical, communication);
        }

        Arrays.sort(c, (a, b) -> {
            if (a.getTotalScore() != b.getTotalScore())
                return b.getTotalScore() - a.getTotalScore();

            return a.id - b.id;
        });

        for (int i = 0; i < k; i++) {
            System.out.println(
                c[i].id + " " + c[i].name + " " +
                c[i].getTotalScore()
            );
        }
    }
}
